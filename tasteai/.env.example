# Copy to .env and set a private key for durable local sessions.
TASTEAI_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
TASTEAI_DATABASE_URL=sqlite:///./tasteai/data/tasteai.db
TASTEAI_ENV=development
TASTEAI_AUTO_CREATE_SCHEMA=true
TASTEAI_RESTAURANT_PROVIDER=demo
TASTEAI_MENU_EVIDENCE_TTL_SECONDS=604800
# Menu-photo routes are disabled unless account IDs are explicitly allowlisted.
# Keep empty by default; set only trusted reviewer user IDs, comma-separated.
TASTEAI_MENU_PHOTO_REVIEWER_USER_IDS=
# Private local storage is outside the public web/static directory by default.
# TASTEAI_MENU_PHOTO_STORAGE_DIR=C:/private/tasteai/menu-photos
TASTEAI_MENU_PHOTO_MAX_BYTES=10485760
TASTEAI_MENU_PHOTO_MAX_PIXELS=20000000
# External OCR/Vision is disabled by default. When explicitly enabled, uploaded menu photos
# are sent to the configured provider and extracted rows remain pending human review.
TASTEAI_ALLOW_EXTERNAL_OCR=false
TASTEAI_OCR_PROVIDER=openai
TASTEAI_OCR_MODEL=gpt-4.1-mini
TASTEAI_OCR_TIMEOUT=20
# Optional LLM/query extraction and external semantic embeddings are separately gated.
TASTEAI_ALLOW_LLM=false
TASTEAI_LLM_PROVIDER=openai
TASTEAI_LLM_MODEL=gpt-4.1-mini
TASTEAI_LLM_TIMEOUT=10
TASTEAI_LLM_MAX_TOKENS=400
TASTEAI_LLM_MAX_RETRIES=1
TASTEAI_ALLOW_EXTERNAL_EMBEDDINGS=false
TASTEAI_EMBEDDING_PROVIDER=openai
TASTEAI_EMBEDDING_MODEL=text-embedding-3-small
TASTEAI_EMBEDDING_TIMEOUT=10
# OPENAI_API_KEY is optional and must be supplied through a private environment source.
# Exact-dish evidence search excludes stale menu records by default.
# TASTEAI_EVIDENCE_STALE_POLICY=exclude
# Optional JSON weights for evidence-search; configured values are normalized.
# Defaults: dish match .25, evidence confidence .25, freshness .20, price fit .15,
# taste match .10, availability confidence .05.
# TASTEAI_EVIDENCE_RANKING_WEIGHTS={"dish_match":0.25,"evidence_confidence":0.25,"freshness":0.20,"price_fit":0.15,"taste_match":0.10,"availability_confidence":0.05}
# Alternative compatibility name: RESTAURANT_PROVIDER=demo
# Live Google Places requests may incur charges and remain disabled unless explicitly opted in.
# TASTEAI_ALLOW_PAID_PLACES_LOOKUPS=false
# To enable, set the provider to google, opt in, and provide a server-side key.
# GOOGLE_PLACES_API_KEY=
# Google Places also requires publicly accessible policy URLs before live lookup is enabled.
# TASTEAI_TERMS_URL=https://example.com/terms
# TASTEAI_PRIVACY_URL=https://example.com/privacy
# The optional live smoke test is billable and is skipped unless this is explicitly true.
# GOOGLE_PLACES_LIVE_TEST=false
# Optional OpenStreetMap lookup uses user-triggered Nominatim + Overpass requests.
# The /api/v1/restaurants/discover endpoint does not expand the requested radius.
# It requires a descriptive application User-Agent; no live calls are made in tests.
# TASTEAI_RESTAURANT_PROVIDER=osm
# TASTEAI_OSM_USER_AGENT=TasteAI/0.1 (contact: operator@example.com)
# TASTEAI_OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# TASTEAI_OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional JSON overrides; weights are normalized by the ranking engine.
# Current defaults: taste 0.28, intent 0.42, history 0.13, price 0.10, novelty 0.07.
# TASTEAI_RANKING_WEIGHTS={"taste":0.28,"intent":0.42,"history":0.13,"price":0.10,"novelty":0.07}
# TASTEAI_INTENT_WEIGHTS={"protein":1.0,"spice":2.0,"crunch":2.0,"filling":2.0,"healthy":1.5,"adventure":1.0,"cuisine":1.0,"liked_ingredient":1.0,"sweet":1.0,"sour":1.0,"richness":1.0,"smokiness":1.0}
